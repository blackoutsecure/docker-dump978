#!/usr/bin/with-contenv bash

set -euo pipefail

# shellcheck disable=SC1091
source /usr/local/bin/log-functions.sh
SVC_NAME="nginx"

dump978_web_port=${DUMP978_WEB_PORT:-8978}
dump978_web_port_ext=${DUMP978_WEB_PORT_EXTERNAL:-${dump978_web_port}}

log_info "starting dump978 web UI on port ${dump978_web_port}"

# Background task: wait for nginx to actually listen, then log.
# Subshell inherits SVC_NAME and the log_* functions from the parent shell.
(
    for _ in $(seq 1 30); do
        if wget -q --spider "http://127.0.0.1:${dump978_web_port}/" 2>/dev/null; then
            log_info "web server running on port ${dump978_web_port}"
            log_info "connection ready: http://<host-ip>:${dump978_web_port_ext}/"
            exit 0
        fi
        sleep 0.5
    done
    log_warn "port ${dump978_web_port} not detected after 15s"
) &

exec nginx -g 'daemon off;'
